# ============================================
# GOOGLE APPS SCRIPT (INTRANET)
# ============================================
# URL del Apps Script para login, usuarios y documentos
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_INTRANET_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# ============================================
# CONFIGURACIÓN DE REVALIDATION
# ============================================
# Tiempo en segundos para revalidar datos de Google Sheets (default: 300 = 5 min)
NEXT_PUBLIC_DATA_REVALIDATE_TIME=300

# ============================================
# MODO DEBUG
# ============================================
# Mostrar logs de fetch/validación en consola (true/false)
NEXT_PUBLIC_DEBUG_MODE=false
